    <string name="checks_virustotal_note">A böngészője csak a fájl ujjlenyomatát küldi el, és olyan fájl, amelyet senki sem töltött még fel a VirusTotalra, nem lesz ott megtalálható.</string>
    <string name="advice_network">A Tern nem tudta elérni a forrást. Ellenőrizze a kapcsolatot vagy a proxyt, majd próbálja újra.</string>
    <string name="advice_rate_limited">A forrás korlátozza, hogy milyen gyakran lehet lekérdezni. Egy mentett hozzáférési token ehhez a gazdagéphez megemeli a korlátot.</string>
    <string name="advice_not_found">Lehet, hogy a projekt elköltözött vagy priváttá vált. Ellenőrizze, hogy a link továbbra is megnyílik-e a böngészőben.</string>
    <string name="advice_auth">A forrás elutasította a hozzáférési tokent. Cserélje ki a Beállításokban, a hozzáférési tokenek alatt.</string>
    <string name="advice_parse">A forrás olyasmivel válaszolt, amit a Tern nem tudott elolvasni. Lehet, hogy átmeneti hiba van az ő oldalukon.</string>
    <string name="advice_no_releases">A projekt még nem tett közzé olyan kiadást, amelyet a Tern használni tudna. Az előzetes kiadások számítanak, ha bekapcsolja őket.</string>
    <string name="advice_no_file">A fájlok egyike sem felel meg ennek az eszköznek. Válasszon egyet maga a Fájlválasztás alatt, vagy módosítsa a belefoglalási és kizárási mintákat.</string>
    <string name="advice_checksum_mismatch">A fájl a közzététel után megváltozott, vagy megsérült útközben. Ne telepítse. Próbálja újra később.</string>
    <string name="advice_signer_mismatch">A fájl egy másik tanúsítvánnyal van aláírva, mint amelyik ehhez az alkalmazáshoz van rögzítve, így a Tern elutasítja. Ha a fejlesztő új kulcsot jelentett be, cserélje ki a rögzített tanúsítványt a Haladó menüpont alatt.</string>
    <string name="advice_signer_broken">A fájlban lévő aláírások nem egyeznek meg egymással. Ne telepítse, és értesítse a fejlesztőt.</string>
    <string name="advice_signer_mismatch_installed">Az Android nem cserél le egy alkalmazást olyannal, amelyet valaki más írt alá, és a Tern sem próbálja meg. Ha a fejlesztő új kulcsot jelentett be, az alkalmazást el kell távolítani és újra kell telepíteni, ami törli az adatait.</string>
    <string name="advice_package_mismatch">A fájl egy másik alkalmazás, mint amit követ. Ellenőrizze a belefoglalási és kizárási mintákat a Fájlválasztás alatt.</string>
    <string name="advice_downgrade">A felkínált verzió régebbi, mint a telepített, és az Android nem telepít régebbit egy újabbra. A visszatérés azt jelenti, hogy először el kell távolítani az alkalmazást, ami törli az adatait.</string>
    <string name="advice_install_failed">Az Android megtagadta a telepítést. A megadott ok fent látható.</string>
    <string name="advice_storage">Nincs elég szabad tárhely. Szabadítson fel valamennyit, majd próbálja újra.</string>
    <string name="advice_unsupported">Ennek az alkalmazásnak újabb Androidra vagy egy másik eszközre van szüksége.</string>
