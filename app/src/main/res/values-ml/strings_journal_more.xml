<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="journal_section">ആക്റ്റിവിറ്റി ലോഗ്</string>
    <string name="journal_keep_own">Tern-ൻ്റെ സ്വന്തം സന്ദേശങ്ങൾ ലോഗിൽ സൂക്ഷിക്കുക</string>
    <string name="journal_keep_own_effect">Tern-ൻ്റെ മുന്നറിയിപ്പുകളും പിശകുകളും, ഓരോ പരിശോധനയുടെയും ആരംഭവും അവസാനവും. പാസ്‌വേഡോ ടോക്കണോ ആകാൻ സാധ്യതയുള്ള ഒന്നും ഉൾപ്പെടുത്തില്ല, നിങ്ങൾ പങ്കിടുന്നില്ലെങ്കിൽ ലോഗ് ഈ ഉപകരണത്തിൽ മാത്രമേ ഉണ്ടാകൂ.</string>
    <string name="journal_filter_own">Tern-ൻ്റെ സന്ദേശങ്ങൾ</string>
    <string name="journal_mark_note">Tern-ൽ നിന്നുള്ള കുറിപ്പ്</string>
    <string name="journal_mark_warning">Tern-ൽ നിന്നുള്ള മുന്നറിയിപ്പ്</string>
    <string name="journal_mark_error">Tern-ൽ നിന്നുള്ള പിശക്</string>
