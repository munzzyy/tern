    <string name="settings_confirm_update_all_effect">എത്ര ആപ്പുകൾ ഇൻസ്റ്റാൾ ചെയ്യുകയോ അപ്ഡേറ്റ് ചെയ്യുകയോ ചെയ്യുമെന്ന് പറയുകയും, ഒരു സമ്മതത്തിനായി കാത്തിരിക്കുകയും ചെയ്യുന്നു.</string>
    <plurals name="bulk_install_title">
        <item quantity="one">%d ആപ്പ് ഇൻസ്റ്റാൾ ചെയ്യണോ?</item>
        <item quantity="other">%d ആപ്പുകൾ ഇൻസ്റ്റാൾ ചെയ്യണോ?</item>
    </plurals>
    <string name="bulk_install_text">Android-നോട് ഇൻസ്റ്റാൾ ചെയ്യാൻ ആവശ്യപ്പെടുന്നതിന് മുമ്പ് ഓരോ ഫയലും ഡൗൺലോഡ് ചെയ്ത് പരിശോധിക്കുന്നു. ഓരോ പുതിയ ആപ്പും ഒപ്പിട്ട സർട്ടിഫിക്കറ്റ് Tern സൂക്ഷിക്കുകയും, തുടർന്നുള്ള ഓരോ അപ്ഡേറ്റും അതേ സർട്ടിഫിക്കറ്റുള്ളതാണെന്ന് ഉറപ്പാക്കുകയും ചെയ്യുന്നു.</string>
    <plurals name="bulk_install_left">
        <item quantity="one">തിരഞ്ഞെടുത്ത ആപ്പുകളിൽ %d എണ്ണത്തിന് ഇപ്പോൾ ഇൻസ്റ്റാൾ ചെയ്യാൻ ഒന്നുമില്ല, അത് അതുപോലെ തന്നെ വിട്ടിരിക്കുന്നു.</item>
        <item quantity="other">തിരഞ്ഞെടുത്ത ആപ്പുകളിൽ %d എണ്ണത്തിന് ഇപ്പോൾ ഇൻസ്റ്റാൾ ചെയ്യാൻ ഒന്നുമില്ല, അവ അതുപോലെ തന്നെ വിട്ടിരിക്കുന്നു.</item>
    </plurals>
