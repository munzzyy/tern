    <string name="style_vibrant">鲜艳</string>
    <string name="style_expressive">富有表现力</string>
    <string name="look_style_effect">“鲜艳”会让整体色彩更丰富。“富有表现力”会让第二种和第三种颜色的色相进一步偏离第一种颜色。</string>
    <string name="look_color_code">颜色代码</string>
    <string name="look_color_code_effect">Tern 会取此颜色的色相和饱和度，并从中挑选出依然易于阅读的深浅色调。</string>
    <string name="look_color_code_invalid">六位十六进制数字，例如 #3D5A80。</string>
    <string name="crash_title">Tern 意外停止运行</string>
    <string name="crash_text">这是它停止运行时正在执行的操作。内容会保留在此设备上；如果希望开发者查看，请将其分享给开发者。</string>
    <string name="crash_share">分享</string>
