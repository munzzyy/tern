    <string name="row_released">Released %1$s</string>
    <string name="row_changes">Changes</string>
    <string name="action_show_changes">Show the changes</string>

    <!-- The Update all button, and what it takes in. -->
    <string name="action_install_all">Install all</string>
    <string name="action_install_update_all">Install and update all</string>
    <plurals name="apps_section_installs">
        <item quantity="one">%d app is not installed yet</item>
        <item quantity="other">%d apps are not installed yet</item>
    </plurals>
    <plurals name="update_all_title">
        <item quantity="one">Install and update %d app?</item>
        <item quantity="other">Install and update %d apps?</item>
    </plurals>
    <string name="settings_update_all">The Update all button</string>
    <string name="update_all_updates">Updates only</string>
    <string name="update_all_all">Updates and apps not installed yet</string>
