    <string name="settings_confirm_update_all">Ask before Update all</string>
    <string name="settings_confirm_update_all_effect">Says how many apps it installs or updates, and waits for a yes.</string>

    <!-- Installing the apps picked in the list. -->
    <plurals name="bulk_install_title">
        <item quantity="one">Install %d app?</item>
        <item quantity="other">Install %d apps?</item>
    </plurals>
    <string name="bulk_install_text">Each file is downloaded and checked before Android is asked to install it. Tern keeps the certificate each new app is signed with, and holds every later update to it.</string>
    <!-- %d is how many of the picked apps have nothing to install and are left as they are. -->
    <plurals name="bulk_install_left">
        <item quantity="one">%d of the picked apps has nothing to install now and is left as it is.</item>
        <item quantity="other">%d of the picked apps have nothing to install now and are left as they are.</item>
    </plurals>

    <!-- The categories of the apps picked in the list. -->
    <string name="action_change_categories">Change categories</string>
    <plurals name="bulk_categories_title">
        <item quantity="one">Categories of %d app</item>
        <item quantity="other">Categories of %d apps</item>
    </plurals>
    <string name="bulk_categories_help">A tick files every picked app under a category, and an empty box takes them all out of it. A dash leaves each app as it is.</string>
    <string name="categories_filed_all">Every picked app</string>
    <string name="categories_filed_some">Some of the picked apps</string>
    <string name="categories_filed_none">None of the picked apps</string>
    <plurals name="bulk_categories_done">
        <item quantity="one">Changed the categories of %d app.</item>
        <item quantity="other">Changed the categories of %d apps.</item>
    </plurals>

